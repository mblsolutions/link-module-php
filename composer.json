{
    "name": "mblsolutions/link-module-php",
    "description": "Official Link Module interface for PHP applications.",
    "type": "package",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "MBLSolutions\\LinkModule\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Jon K",
            "email": "jonknibbs@paypoint.com"
        },
        {
            "name": "Hayley Berry",
            "email": "hayley.berry@appreciategroup.co.uk"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "larastan/larastan": "^3.0",
        "brianium/paratest": "^7.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:parallel": "paratest --parallel-suite"
    }
}
